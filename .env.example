# ===== LLM 配置（必须）=====
# LLM 提供商：servicehub（通过 ServiceHub 调用 MiniMax-M2.7-highspeed，无需本地 API Key）
TRADINGAGENTS_LLM_PROVIDER=servicehub
TRADINGAGENTS_DEEP_THINK_LLM=MiniMax-M2.7-highspeed
TRADINGAGENTS_QUICK_THINK_LLM=MiniMax-M2.7-highspeed

# ===== ServiceHub 鉴权（必须）=====
# 你的 ServiceHub 账号用户名
SERVICETUBER_USERNAME=your_username_here
# 你的 ServiceHub 账号 passtoken
SERVICETUBER_PASSTOKEN=your_passtoken_here
# ServiceHub 地址（生产环境用下面这个，不要改）
SERVICETUBER_BASE_URL=https://www.ccailab.top
